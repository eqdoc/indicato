{
  "name": "indicato",
  "version": "0.2.0",
  "description": "Technical analysis for JavaScript: 89 indicators, all 61 TA-Lib candlestick patterns, indicator events and chart patterns with drawable geometry. Verified against TA-Lib, proven not to read the future. No dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs/reference.md",
    "docs/accuracy.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js",
    "docs": "node scripts/build-docs.mjs",
    "pretest": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "technical-analysis",
    "indicators",
    "trading",
    "finance",
    "backtesting",
    "rsi",
    "macd",
    "bollinger-bands",
    "supertrend",
    "ichimoku",
    "talib",
    "candlestick-patterns",
    "chart-patterns",
    "head-and-shoulders"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eqdoc/indicato.git"
  },
  "homepage": "https://github.com/eqdoc/indicato",
  "bugs": {
    "url": "https://github.com/eqdoc/indicato/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
